<Application x:Class="Centraly.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Centraly.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
            <conv:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!--
                TODO: replace with the actual Cairo font family (same as the old React
                frontend's src/index.css) once the .ttf files are added to Assets/Fonts.
                Segoe UI is used as a placeholder - it has full Arabic glyph coverage so the
                app is usable in the meantime.
            -->
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

            <!-- Palette copied 1:1 from the old frontend's src/index.css CSS variables. -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextMainBrush" Color="#374151" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
            <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

            <Style TargetType="{x:Type Window}">
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
