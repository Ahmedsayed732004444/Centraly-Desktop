<Page x:Class="Centraly.Desktop.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="المنتجات"
      FlowDirection="RightToLeft"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <ui:Button DockPanel.Dock="Left" Content="+ إضافة منتج" Appearance="Primary" Width="130" Click="OnAddProductClick" Margin="8,0,0,0" />
            <ui:Button DockPanel.Dock="Left" Content="بحث" Width="80" Margin="8,0,0,0" Click="OnSearchClick" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="ابحث بالاسم أو الباركود..." KeyDown="OnSearchBoxKeyDown" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="الصورة" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ProductImageConverter}}"
                                           Height="36" Width="36" Stretch="UniformToFill" Margin="4" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120" />
                        <DataGridTextColumn Header="القسم" Binding="{Binding Department.Name}" Width="110" />
                        <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="110" />
                        <DataGridTextColumn Header="النوع" Binding="{Binding Usage, Converter={StaticResource ProductUsageToLabelConverter}}" Width="90" />
                        <DataGridTextColumn Header="الكمية" Binding="{Binding TotalQuantity}" Width="70" />
                        <DataGridTextColumn Header="الدفعات" Binding="{Binding Batches.Count}" Width="70" />
                        <DataGridTextColumn Header="موقع التخزين" Binding="{Binding StorageLocation}" Width="110" />
                        <DataGridTextColumn Header="حالة المخزون" Binding="{Binding Converter={StaticResource StockStatusConverter}}" Width="100" />
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                            Click="OnDeleteProductClick" Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyStateText" Text="لا توجد منتجات بعد" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
