<Page x:Class="Centraly.Desktop.Views.NewPurchasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="فاتورة مشتريات"
      FlowDirection="RightToLeft"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Search -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="بحث عن منتج" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Left" Content="بحث" Appearance="Primary" Width="80" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
                    <ui:TextBox PlaceholderText="ابحث بالاسم أو الباركود..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="OnSearchBoxKeyDown" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <ListView x:Name="ResultsList" ItemsSource="{Binding SearchResults}" MouseDoubleClick="OnResultDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="المنتج" Width="180" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="الباركود" Width="120" DisplayMemberBinding="{Binding Barcode}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="ابحث عن منتج واضغط عليه مرتين لإضافته للفاتورة" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                               Visibility="{Binding SearchResults, Converter={StaticResource CountToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Invoice -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="المورد" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Width="220" HorizontalAlignment="Right" />
                </DockPanel>

                <Grid Grid.Row="1" MinHeight="120">
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="60" />
                            <DataGridTextColumn Header="سعر الشراء" Binding="{Binding UnitCost}" Width="90" />
                            <DataGridTextColumn Header="سعر الجملة" Binding="{Binding WholesalePrice}" Width="90" />
                            <DataGridTextColumn Header="سعر التجزئة" Binding="{Binding RetailPrice}" Width="90" />
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:0.##}}" IsReadOnly="True" Width="80" />
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="لم تتم إضافة أصناف بعد" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items, Converter={StaticResource CountToVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Total, StringFormat='الإجمالي: {0:0.##}'}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrandPrimaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="المدفوع" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <ui:TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ui:TextBox PlaceholderText="ملاحظات" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"
                               Visibility="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" Margin="0,4,0,4" />

                    <ui:Button Content="حفظ الفاتورة" Appearance="Primary" HorizontalAlignment="Stretch" Height="42"
                               Command="{Binding SaveCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertedBooleanConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
