<Page x:Class="Centraly.Desktop.Views.ComingSoonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ComingSoonPage"
      Background="{StaticResource PageBackgroundBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="قريباً" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="هذه الشاشة لسه في مرحلة البناء" FontSize="14"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Page>
