<ui:FluentWindow x:Class="Centraly.Desktop.Views.AddSupplierWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="مورد"
                 Width="420" Height="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FlowDirection="RightToLeft"
                 Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,0,20,12">
            <TextBlock Text="اسم المورد" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" />

            <TextBlock Text="النوع" Margin="0,0,0,4" />
            <ui:TextBox x:Name="TypeBox" Margin="0,0,0,12" />

            <TextBlock Text="الهاتف" Margin="0,0,0,4" />
            <ui:TextBox x:Name="PhoneBox" Margin="0,0,0,12" />

            <TextBlock Text="العنوان" Margin="0,0,0,4" />
            <ui:TextBox x:Name="AddressBox" Margin="0,0,0,12" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,20,16">
            <ui:Button Content="حفظ" Appearance="Primary" Width="100" Margin="0,0,8,0" Click="OnSaveClick" />
            <ui:Button Content="إلغاء" Width="100" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
