<ui:FluentWindow x:Class="Centraly.Desktop.Views.BatchPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="اختيار الدفعة"
                 Width="480" Height="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ProductNameText" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   Margin="16,0,16,8" HorizontalAlignment="Right" />

        <ListBox x:Name="BatchesList" Grid.Row="1" Margin="16,0,16,8"
                 DisplayMemberPath="Display" SelectedIndex="0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,8">
            <TextBlock Text="الكمية" VerticalAlignment="Center" Margin="8,0" />
            <ui:TextBox x:Name="QuantityBox" Text="1" Width="100" />
            <TextBlock Text="السعر" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox x:Name="PriceTypeCombo" Width="110" SelectedIndex="0">
                <ComboBoxItem Content="تجزئة" />
                <ComboBoxItem Content="جملة" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,8,16,16">
            <ui:Button Content="إضافة" Appearance="Primary" Width="100" Margin="0,0,8,0" Click="OnAddClick" />
            <ui:Button Content="إلغاء" Width="100" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
