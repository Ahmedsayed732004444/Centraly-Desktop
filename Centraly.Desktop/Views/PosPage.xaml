<Page x:Class="Centraly.Desktop.Views.PosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="شاشة الكاشير"
      FlowDirection="RightToLeft"
      Background="{StaticResource PageBackgroundBrush}">

    <Page.Resources>
        <!-- Product card: image-or-avatar, stock badge, name, category, stock count, add button. -->
        <DataTemplate x:Key="ProductCardTemplate">
            <Border Width="172" Margin="6" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" HorizontalAlignment="Left" Background="{Binding Converter={StaticResource StockStatusBrushConverter}}"
                            CornerRadius="6" Padding="8,2" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Converter={StaticResource StockStatusConverter}}" FontSize="10" FontWeight="Bold"
                                   Foreground="{Binding Converter={StaticResource StockStatusForegroundConverter}}" />
                    </Border>

                    <Grid Grid.Row="1" Width="64" Height="64" Margin="0,0,0,8" HorizontalAlignment="Center">
                        <Ellipse Fill="{Binding ImageUrl, Converter={StaticResource ProductImageBrushConverter}}"
                                 Visibility="{Binding ImageUrl, Converter={StaticResource ImageAvailableToVisibilityConverter}}" />
                        <Ellipse Fill="{Binding Name, Converter={StaticResource AvatarBackgroundConverter}}"
                                 Visibility="{Binding ImageUrl, Converter={StaticResource ImageUnavailableToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Name, Converter={StaticResource AvatarInitialConverter}}"
                                   Foreground="{Binding Name, Converter={StaticResource AvatarForegroundConverter}}"
                                   FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ImageUrl, Converter={StaticResource ImageUnavailableToVisibilityConverter}}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="3" Text="{Binding Converter={StaticResource ProductSubtitleConverter}}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="4" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"
                               Foreground="{Binding Converter={StaticResource StockStatusForegroundConverter}}">
                        <Run Text="المخزون: " />
                        <Run Text="{Binding TotalQuantity, Mode=OneWay}" />
                    </TextBlock>

                    <ui:Button Grid.Row="5" Content="+ إضافة" HorizontalAlignment="Stretch"
                               Background="{StaticResource PosAccentBrush}" Foreground="White"
                               IsEnabled="{Binding TotalQuantity, Converter={StaticResource PositiveIntToBooleanConverter}}"
                               Click="OnAddToCartClick" Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Cart line: thumbnail, name + supplier, qty stepper, price, remove. -->
        <DataTemplate x:Key="CartLineTemplate">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                            VerticalAlignment="Top" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}" />

                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SupplierName}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:0.##} ج.م.'}" Foreground="{StaticResource PosAccentBrush}" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+" Width="26" Height="26"
                                Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="-" Width="26" Height="26"
                                Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- Search + product grid -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <ComboBox DockPanel.Dock="Left" x:Name="DepartmentCombo" Width="170"
                          ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}"
                          DisplayMemberPath="Name" />
                <ui:TextBox Margin="8,0,0,0" PlaceholderText="ابحث عن منتج بالاسم أو امسح الباركود..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="OnSearchBoxKeyDown" />
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource ProductCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="لا توجد منتجات مطابقة" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SearchResults, Converter={StaticResource CountToVisibilityConverter}}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <ui:Button Content="السابق" Width="90" Margin="0,0,8,0" Command="{Binding PrevPageCommand}" />
                <TextBlock VerticalAlignment="Center" Margin="8,0">
                    <Run Text="صفحة" /> <Run Text="{Binding PageNumber, Mode=OneWay}" /> <Run Text="من" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
                </TextBlock>
                <ui:Button Content="التالي" Width="90" Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>

        <!-- Cart -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Content="🗑" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMutedBrush}" Command="{Binding ClearCartCommand}" />
                    <StackPanel>
                        <TextBlock Text="سلة المشتريات" FontSize="16" FontWeight="Bold" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                            <Run Text="الكمية" /> <Run Text="{Binding CartQuantity, Mode=OneWay}" /> <Run Text="|" /> <Run Text="{Binding CartItemCount, Mode=OneWay}" /> <Run Text="أصناف" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cart}" ItemTemplate="{StaticResource CartLineTemplate}" />
                    </ScrollViewer>
                    <TextBlock Text="السلة فارغة" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Cart, Converter={StaticResource CountToVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding CartTotal, StringFormat='{}{0:0.##} ج.م.'}" FontWeight="Bold" />
                        <TextBlock Text="المجموع الفرعي" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding CartTotal, StringFormat='{}{0:0.##} ج.م.'}" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource PosAccentBrush}" />
                        <TextBlock Text="الإجمالي" Foreground="{StaticResource TextMainBrush}" FontWeight="Bold" />
                    </DockPanel>

                    <ui:Button Content="دفع كاش" Background="{StaticResource PosAccentBrush}" Foreground="White" Height="42" Margin="0,0,0,8"
                               Click="OnCashClick" IsEnabled="{Binding CartItemCount, Converter={StaticResource PositiveIntToBooleanConverter}}" />
                    <ui:Button Content="دفع آجل" Height="42"
                               Click="OnDeferredClick" IsEnabled="{Binding CartItemCount, Converter={StaticResource PositiveIntToBooleanConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
