<Page x:Class="Centraly.Desktop.Views.PosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="شاشة الكاشير"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- Search + results -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Left" Content="بحث" Appearance="Primary" Width="90"
                               Command="{Binding SearchCommand}" />
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="ابحث بالاسم أو الباركود..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="OnSearchBoxKeyDown" />
                </DockPanel>

                <ListView Grid.Row="1" x:Name="ResultsList" ItemsSource="{Binding SearchResults}"
                          MouseDoubleClick="OnResultDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="المنتج" Width="220" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="الباركود" Width="120" DisplayMemberBinding="{Binding Barcode}" />
                            <GridViewColumn Header="الكمية الكلية" Width="100" DisplayMemberBinding="{Binding TotalQuantity}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Cart + checkout -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Cart}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="60" />
                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice}" Width="80" />
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:0.##}}" IsReadOnly="True" Width="80" />
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="{Binding CartTotal, StringFormat='الإجمالي: {0:0.##}'}"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"
                               HorizontalAlignment="Right" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Right">
                        <RadioButton Content="نقدي" IsChecked="{Binding IsCash}" GroupName="PaymentMethod" Margin="0,0,16,0" />
                        <RadioButton Content="آجل" IsChecked="{Binding IsCash, Converter={StaticResource InvertedBooleanConverter}}" GroupName="PaymentMethod" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCash, Converter={StaticResource InvertedVisibilityConverter}}">
                        <ui:TextBox PlaceholderText="اسم العميل" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <ui:TextBox PlaceholderText="هاتف العميل" Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <ui:TextBox PlaceholderText="المبلغ المدفوع" Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"
                               Visibility="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" Margin="0,4,0,4" />

                    <ui:Button Content="إتمام البيع" Appearance="Primary" HorizontalAlignment="Stretch" Height="42"
                               Command="{Binding CheckoutCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertedBooleanConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
