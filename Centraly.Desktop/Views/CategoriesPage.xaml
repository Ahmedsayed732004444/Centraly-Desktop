<Page x:Class="Centraly.Desktop.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="التصنيفات"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="الأقسام" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,12" HorizontalAlignment="Right" />

                <ListBox x:Name="DepartmentsList" Grid.Row="1" DisplayMemberPath="Name"
                         SelectionChanged="OnDepartmentSelected" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <ui:Button Content="إضافة" Appearance="Primary" Width="90" Margin="0,0,8,0" Click="OnAddDepartmentClick" />
                    <ui:Button Content="تعديل" Width="90" Margin="0,0,8,0" Click="OnEditDepartmentClick" />
                    <ui:Button Content="حذف" Width="90" Click="OnDeleteDepartmentClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="التصنيفات" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,12" HorizontalAlignment="Right" />

                <ListBox x:Name="CategoriesList" Grid.Row="1" DisplayMemberPath="Name" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <ui:Button Content="إضافة" Appearance="Primary" Width="90" Margin="0,0,8,0" Click="OnAddCategoryClick" />
                    <ui:Button Content="تعديل" Width="90" Margin="0,0,8,0" Click="OnEditCategoryClick" />
                    <ui:Button Content="حذف" Width="90" Click="OnDeleteCategoryClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
