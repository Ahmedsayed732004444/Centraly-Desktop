<ui:FluentWindow x:Class="Centraly.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="سنترالي"
                 Width="1280" Height="800"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource PageBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="16,16,16,4" />
        </Style>
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="سنترالي" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="PageHost" Grid.Column="0" Background="{StaticResource PageBackgroundBrush}" />

            <Border Grid.Column="1" Background="{StaticResource SidebarBackgroundBrush}">
                <DockPanel>
                    <TextBlock Text="سنترالي" DockPanel.Dock="Top"
                               Foreground="White" FontSize="20" FontWeight="Bold"
                               Margin="16,20,16,16" HorizontalAlignment="Right" />

                    <Button x:Name="LogoutButton" DockPanel.Dock="Bottom" Content="تسجيل الخروج"
                            Style="{StaticResource SidebarItemStyle}" Click="OnLogoutClick"
                            Foreground="#F87171" Margin="0,8,0,16" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MenuPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
